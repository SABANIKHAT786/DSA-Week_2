
class Solution {
    public boolean isAnagram(String s, String t) {
        char[] arrays1 = s.toCharArray();
        char[] arrays2 = t.toCharArray();
        Arrays.sort(arrays1);
        Arrays.sort(arrays2);
        if(Arrays.equals(arrays1 , arrays2)){
            return true;
        }
        return false;
    }
}
